# ==============================================================================
# CORNERSTONE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Production connection string for PostgreSQL (Neon, Supabase, AWS RDS, Render, etc.)
# If left empty in local development, Cornerstone automatically uses a persistent
# local database in .data/ for zero-config testing.
# In production (e.g. Vercel deployment), DATABASE_URL is strictly required.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. ADMINISTRATOR CREDENTIALS & INITIAL SEEDING
# ------------------------------------------------------------------------------
# Used to seed the initial admin account upon the first migration/startup.
# You can also use "node scripts/create-admin.js <username> <password>" at any time.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CornerStone@Admin2026

# ------------------------------------------------------------------------------
# 3. SESSION SECURITY
# ------------------------------------------------------------------------------
# A secure 32+ character random string used for session entropy & CSRF hardening.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cornerstone-super-secure-session-entropy-key-2026-production

# ------------------------------------------------------------------------------
# 4. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH & GMAIL API (CUSTOMER REPLIES VIA GMAIL)
# ------------------------------------------------------------------------------
# In Google Cloud Console (https://console.cloud.google.com):
# 1. Create a project or select an existing one.
# 2. Enable the "Gmail API" (APIs & Services > Library > Gmail API > Enable).
# 3. Configure the OAuth Consent Screen (APIs & Services > OAuth consent screen):
#    - User Type: External (or Internal if using Google Workspace organization)
#    - Scopes:
#        https://www.googleapis.com/auth/gmail.send
#        https://www.googleapis.com/auth/userinfo.email
#    - Test Users: Add the Gmail address you want to authorize from (if in Testing status)
# 4. Create OAuth 2.0 Credentials (APIs & Services > Credentials > Create Credentials > OAuth client ID):
#    - Application type: Web application
#    - Authorized redirect URIs:
#        - Development: http://localhost:5173/api/auth/google/callback
#        - Production: https://yourdomain.com/api/auth/google/callback
# 5. Copy the Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
# Optional redirect URI override (defaults automatically to ${proto}://${host}/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
